{
  "name": "Zenbo Music and Dance Every 10 Minutes",
  "nodes": [
    {
      "parameters": {"rule": {"interval": [{"field": "minutes", "minutesInterval": 10}]}},
      "id": "music-schedule",
      "name": "Every 10 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CORE_API_URL + '/api/v1/music-playlists/' + $env.ZENBO_MUSIC_PLAYLIST_ID + '/start' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ robot_slug: $env.ZENBO_MUSIC_ROBOT_SLUG, dance_action_ids: [Number($env.ZENBO_DANCE_ACTION_ID)], duration_seconds: Number($env.ZENBO_MUSIC_DANCE_DURATION_SECONDS || 45) }) }}",
        "options": {"timeout": 15000}
      },
      "id": "start-bounded-dance-window",
      "name": "Start Reviewed Playlist Window",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 300]
    }
  ],
  "connections": {
    "Every 10 Minutes": {"main": [[{"node": "Start Reviewed Playlist Window", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"},
  "staticData": null,
  "tags": [{"name": "zenbo"}, {"name": "music"}, {"name": "safety-gated"}]
}
