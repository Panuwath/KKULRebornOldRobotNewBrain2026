# MQTT is authenticated by default. Generate a high-entropy value per robot
# environment and keep the real .env outside Git.
MQTT_AUTH_REQUIRED=true
MQTT_USERNAME=zenbo-client
MQTT_TOKEN=replace-with-a-long-random-token
# Hostinger backup broker example: mqtt.pingdev.site, 443, wss
MQTT_HOST=mqtt-broker
MQTT_PORT=1883

# Required only when n8n imports new L0 scenario definitions. Keep the real
# value outside Git and set the same value in n8n's SCENARIO_REGISTRY_TOKEN.
SCENARIO_REGISTRY_TOKEN=replace-with-another-long-random-token

# Keep false until canned dance actions and YouTube playback have been proven
# on the physical Zenbo. The n8n 10-minute music workflow checks this gate.
MUSIC_DANCE_AUTOMATION_ENABLED=false

# L8 is a supervised 5-15cm straight micro-movement only.  Keep false until
# the actual robot has passed the current field attestation and safety checks.
AUTONOMOUS_MOTION_ENABLED=false
RELATIVE_MOTION_ENABLED=false
RELATIVE_MOTION_MAX_SPEED=1
RELATIVE_MOTION_MAX_DISTANCE_M=0.15
RELATIVE_MOTION_HARD_STOP_MS=1500

# L12 requires a fresh certification for the exact calibrated route version.
ROUTE_CERTIFICATION_REQUIRED=true

# L13-L20: require an operator-governed release, safety evidence, zone lease,
# recent fault drill and short-lived operation permit before an L10 route run.
# These records do not replace a physical Zenbo acceptance test.
AUTONOMY_GOVERNANCE_REQUIRED=true
AUTONOMY_PERMIT_TTL_SECONDS=900

# APK MQTT provisioning. Build the Android app with the separate bootstrap
# token, but keep the MQTT token exclusively on the server. Use `ssl` or `wss`
# and a TLS-enabled broker in production so the returned credential is not sent
# over plaintext MQTT. Hostinger backup example below.
ZENBO_DEVICE_PROVISIONING_TOKEN=replace-with-a-per-device-bootstrap-token
ZENBO_DEVICE_ROBOT_SLUG=booky-1
MQTT_CLIENT_HOST=mqtt.pingdev.site
MQTT_CLIENT_PORT=443
MQTT_CLIENT_TRANSPORT=wss
MQTT_CLIENT_TOPIC_ROOT=zenbo

# Database adapter. Leave DB_CONNECTION empty to use COMMAND_HISTORY_DB SQLite.
DB_CONNECTION=
DB_HOST=
DB_PORT=5436
DB_DATABASE=zenbo
DB_USERNAME=
DB_PASSWORD=

# OpenID Connect web authentication. Supply deployment-specific values only.
OIDC_DISCOVERY_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_SCOPES="openid email profile"
OIDC_SIGNING_ALG=RS256
OIDC_TOKEN_AUTH=client_secret_post
OIDC_AUTHORIZE_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_JWKS_URL=
ZENBO_WEB_ALLOWED_EMAIL_DOMAINS=kku.ac.th,kkumail.com
ZENBO_WEB_ADMIN_EMAILS=
ZENBO_WEB_DEFAULT_ROLE=viewer
APP_SECRET_KEY=
INTERNAL_SERVICE_TOKEN=

# Docker and service endpoints
MQTT_PORT=1883
MQTT_WS_PORT=9001
CORE_API_PORT=5005
TTS_PORT=8000
COMPILER_PORT=5006
SERVER_PUBLIC_HOST=https://libn.kku.ac.th

# Optional semi-automatic APK update manifest.  Host a release-signed APK on
# HTTPS, calculate its SHA-256, and leave every field empty to disable OTA.
APK_UPDATE_URL=
APK_UPDATE_VERSION_CODE=
APK_UPDATE_VERSION_NAME=
APK_UPDATE_SHA256=
APK_UPDATE_NOTES=
