# MQTT is authenticated by default. Generate a high-entropy value per robot
# environment and keep the real .env outside Git.
MQTT_AUTH_REQUIRED=true
MQTT_USERNAME=zenbo-client
MQTT_TOKEN=replace-with-a-long-random-token

# Docker and service endpoints
MQTT_PORT=1883
MQTT_WS_PORT=9001
CORE_API_PORT=5005
TTS_PORT=8000
COMPILER_PORT=5006
SERVER_PUBLIC_HOST=https://libn.kku.ac.th
